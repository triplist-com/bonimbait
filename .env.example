# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bonimbait

# AI Services
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# YouTube
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@TomerChenRihana
YOUTUBE_CHANNEL_ID=UCCehs0A1gUmOUtZIhvkXVJQ

# App
NEXT_PUBLIC_API_URL=http://localhost:8000
# Canonical origin (no trailing slash). The ONLY place the domain is set:
# staging https://bonimbait.com, after cutover https://bonimbayit.co.il.
NEXT_PUBLIC_SITE_URL=https://bonimbait.com
# Public contact email shown on the site (defaults to info@<site host>).
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (production) — used by apps/api / Python scripts
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase — used by apps/web (parity features). Same project values as above.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY (above) is also read by apps/web, server-only.
# Migrated media base (optional; defaults to the "media" bucket's public URL).
# apps/web reads NEXT_PUBLIC_MEDIA_BASE_URL, scripts/migrate/load.py reads MEDIA_BASE_URL.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://xxx.supabase.co/storage/v1/object/public/media
# MEDIA_BASE_URL=https://xxx.supabase.co/storage/v1/object/public/media

# Auth: comma-separated emails that are always admins (promoted on login).
# Google login is configured in Supabase (Auth -> Providers -> Google), not here.
ADMIN_EMAILS=

# Redirects middleware cache TTL in seconds (default 300)
REDIRECT_CACHE_TTL_SECONDS=300
# Admin "test redirect" button: shared secret that makes the middleware reload its redirect map first.
REDIRECT_REFRESH_SECRET=

# Payments: 'mock' (default) or 'upay'
PAYMENT_PROVIDER=mock
# HMAC secret for the mock provider's signed return URLs (required in production)
PAYMENT_MOCK_SECRET=
# Set to 'failed' to make the mock provider simulate a failed payment
PAYMENT_MOCK_OUTCOME=
# UPay (provisional names; confirm with UPay docs when credentials arrive)
UPAY_API_URL=
UPAY_MERCHANT_ID=
UPAY_API_KEY=
UPAY_WEBHOOK_SECRET=
# VAT added to ex-VAT prices (service plans). Default 0.18.
VAT_RATE=0.18

# Platform foundation (docs/platform/FOUNDATION.md)
# Daily AI spend cap in USD per UTC day, all routes; 0 turns AI answers off. Default 3.
AI_DAILY_BUDGET_USD=3
# Feature flags FLAG_<NAME>=true|false (apps/web/lib/flags.ts), e.g. the AI kill switch:
# FLAG_AI_ANSWERS=false
# FLAG_ANALYTICS=false
# Rate-limit overrides RATE_LIMIT_<RULE>=<limit>/<windowSec> (apps/web/lib/guard/rateLimit.ts):
# RATE_LIMIT_AI_ANSWER=20/600
# Pitch site gate: when set, /platform/* needs ?code=<value> once (then a cookie). Unset = open.
PITCH_ACCESS_CODE=

# Revenue engine (docs/platform/briefs/revenue.md). Lead scoring, routing and the booking sheet
# are always on; FLAG_REVENUE=true adds the admin screens, sponsored partner slots, portal stats,
# tier badges/ordering and quote requests.
# FLAG_REVENUE=true
# Signs the booking sheet's lead token (Calendly "scheduled" marks that lead booked).
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
REVENUE_TOKEN_SECRET=

# Content Autopilot (docs/platform/AUTOPILOT.md). YOUTUBE_CHANNEL_ID above is the channel watched.
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"; without it /api/cron/youtube-watch answers 401.
CRON_SECRET=
# Optional podcast feed to watch alongside YouTube
PODCAST_RSS_URL=
# Cron also processes new videos (never publishes); videos per run (1-5)
AUTOPILOT_AUTO_PROCESS=false
AUTOPILOT_AUTO_PROCESS_LIMIT=1
# Budget gate for paid calls (USD): per processing run, and rolling 30 days
AUTOPILOT_MAX_USD_PER_VIDEO=0.10
AUTOPILOT_MONTHLY_BUDGET_USD=2
# Transcript strategy (c): OpenAI transcription of uploaded audio
AUTOPILOT_AUDIO_TRANSCRIPTION=false
# Search fusion: set AUTOPILOT_SEARCH=off to disable; hard cap for the store query
AUTOPILOT_SEARCH=on
AUTOPILOT_SEARCH_TIMEOUT_MS=800
