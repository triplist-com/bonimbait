NEXT_PUBLIC_API_URL=https://bonimbait-api.fly.dev
NEXT_PUBLIC_SITE_URL=https://bonimbait.com
NEXT_PUBLIC_GA_ID=G-XXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (parity features)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Optional: public base of migrated media (Storage bucket "media"). Defaults to
# $NEXT_PUBLIC_SUPABASE_URL/storage/v1/object/public/media. Keep equal to the
# loader's MEDIA_BASE_URL (scripts/migrate/load.py).
# NEXT_PUBLIC_MEDIA_BASE_URL=https://xxx.supabase.co/storage/v1/object/public/media

# Auth
ADMIN_EMAILS=

# Redirects cache (seconds)
REDIRECT_CACHE_TTL_SECONDS=300

# Payments
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=
UPAY_API_URL=
UPAY_MERCHANT_ID=
UPAY_API_KEY=
UPAY_WEBHOOK_SECRET=
VAT_RATE=0.18

# Leads (lib/leads). With no email/webhook configured, leads are only logged.
LEAD_NOTIFY_EMAIL=              # site inbox, comma-separated allowed (e.g. info@bonimbayit.co.il)
RESEND_API_KEY=                 # enables email notifications via Resend
LEAD_NOTIFY_FROM=               # optional sender, default "בונים בית <leads@<site host>>" (domain must be verified in Resend)
LEAD_WEBHOOK_URL=               # optional: POST every lead as JSON (point Zapier/Make here)
LEAD_WEBHOOK_SECRET=            # optional: HMAC-SHA256 -> X-Bonimbait-Signature header
LEAD_IP_SALT=                   # optional salt for hashed IPs (defaults to the service-role key)
LEAD_RATE_LIMIT_MAX=5           # leads per IP per window
LEAD_RATE_LIMIT_WINDOW_MIN=10
TURNSTILE_SECRET_KEY=           # optional Cloudflare Turnstile (server)
NEXT_PUBLIC_TURNSTILE_SITE_KEY= # optional Cloudflare Turnstile (widget)

# Consultation CTA / WhatsApp
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/tzuri-galili-bonimbayit/demo45min
NEXT_PUBLIC_WHATSAPP_NUMBER=972584020730
